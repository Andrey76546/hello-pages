{
  "name": "hello-pages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ci": "npm run lint && npm run type-check && npm test -- --run && npm run build",
    "dev": "vite",
    "build": "tsc -b && vite build",
